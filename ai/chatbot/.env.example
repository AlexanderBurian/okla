# Vytvořte lokální soubor .env. Skutečný klíč nikdy necommitujte.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,http://localhost:3000,https://www.okla.cz,https://okla.cz

# true = bezpečný lokální režim bez volání Groq API
MOCK_MODE=true

MAX_MESSAGE_LENGTH=1200
MAX_HISTORY_MESSAGES=12
CHAT_TIMEOUT_MS=30000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute

# Volitelné: cesta k vlastnímu JSON souboru a veřejný Shoptet XML feed.
KNOWLEDGE_FILE=./data/knowledge.json
SHOPTET_CSV_FILE=./data/shoptet-products.csv
SHOP_BASE_URL=https://825108.myshoptet.com
SHOPTET_FEED_URL=
SHOPTET_FEED_REFRESH_MINUTES=60

# Shoptet Admin API – pro ověřený stav objednávky na stránce /stav-objednavky/.
# Token získáte v administraci Shoptetu (Propojení/API – přístup přes vlastní
# doplněk). Bez tokenu endpoint vrací "nenakonfigurováno" a formulář nabídne
# sledování zásilky přes číslo. Token nikdy necommitujte.
SHOPTET_API_BASE=https://api.myshoptet.com
SHOPTET_API_TOKEN=
